// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Bank balance checkpoint (see docs/PLAN.md's "Bank balance" note): the
  // running balance is computed at read time as bankBalanceCheckpointCents
  // + the net of every Transaction created after
  // bankBalanceCheckpointSetAt — not a running total maintained on every
  // write. No history is kept; setBankBalanceCheckpoint overwrites both
  // fields in place, same "no undo, single current value" rule as every
  // other entity in this schema. Defaults mean a user who never touches
  // this feature still gets a sensible balance: 0 + every transaction
  // they've ever logged.
  bankBalanceCheckpointCents Int      @default(0) @map("bank_balance_checkpoint_cents")
  bankBalanceCheckpointSetAt DateTime @default(now()) @map("bank_balance_checkpoint_set_at")

  // Set once, the moment the default category catalog is seeded for this
  // user (first signup, or a self-heal retry — see authService.verifyOtp).
  // Tracked directly rather than inferred from refresh-token existence: the
  // old "zero refresh tokens" proxy broke whenever a revoked token got
  // cleaned up before the next login could see it, causing spurious
  // reseeds. Null means "never seeded yet."
  defaultCategoriesSeededAt DateTime? @map("default_categories_seeded_at")

  refreshTokens     RefreshToken[]
  categories        Category[]
  budgetMonths      BudgetMonth[]
  categoryMonths    CategoryMonth[]
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  savingsFunds      SavingsFund[]
  savingsMovements  SavingsMovement[]

  @@map("users")
}

model OtpCode {
  id             String   @id @default(uuid()) @db.Uuid
  email          String
  codeHash       String   @map("code_hash")
  expiresAt      DateTime @map("expires_at")
  used           Boolean  @default(false)
  failedAttempts Int      @default(0) @map("failed_attempts")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([email])
  // Both serve authCleanupService's batched row-cleanup queries (expired
  // codes, and used codes regardless of expiry) — see PLAN.md's "Row
  // cleanup" note.
  @@index([expiresAt])
  @@index([used])
  @@map("otp_codes")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @map("token_hash")
  deviceLabel String?  @map("device_label")
  expiresAt   DateTime @map("expires_at")
  revoked     Boolean  @default(false)
  // Set explicitly (not inferred from `updatedAt`) the moment `revoked`
  // flips to true — gives authCleanupService a real cutoff to grace-period
  // against, instead of hard-deleting a just-revoked token before a
  // legitimate concurrent request (e.g. a reuse-detection check, or the
  // next login) can still observe it.
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  // Both serve authCleanupService's batched row-cleanup queries (expired
  // tokens, and revoked tokens regardless of expiry) — see PLAN.md's "Row
  // cleanup" note.
  @@index([expiresAt])
  @@index([revoked])
  @@map("refresh_tokens")
}

enum BudgetType {
  need
  want
  savings

  @@map("budget_type")
}

enum Direction {
  expense
  income

  @@map("direction")
}

enum MovementType {
  deposit
  withdraw

  @@map("movement_type")
}

// One row per user per real calendar month (YYYY-MM, e.g. "2026-03" and
// "2027-03" are distinct rows) — not a recurring 1-12 bucket. `locked`/
// `lockedAt` are inert until Build Order step 5 wires up the locking
// mutation; the columns exist now so category_month/recurring instances
// have a real FK target instead of a raw month string. See docs/PLAN.md's
// "Month Lifecycle" section.
model BudgetMonth {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  month    String
  locked   Boolean   @default(false)
  lockedAt DateTime? @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Restrict, not Cascade: deleteAccount does its own explicit,
  // dependency-ordered delete (see accountService.ts) rather than relying
  // on cascade, which would have to cascade straight through the
  // intentional Restrict relations between the domain tables themselves
  // (e.g. CategoryMonth -> BudgetMonth below) — this is a DB-level
  // backstop confirming that ordering is actually correct, not the
  // deletion mechanism itself. See docs/PLAN.md's GDPR note for the full
  // reasoning (this was a real gap: every user_id here was always meant
  // to be a real FK per PLAN.md's Data Model section, but only
  // refresh_tokens ever got one until now).
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  categoryMonths    CategoryMonth[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, month])
  @@map("budget_months")
}

// Pure catalog — transversal across months, no month-awareness at all.
// Month-scoped state (is it active, what's its budget) lives on
// CategoryMonth, not here. Hard-deleted, not soft-deleted (see docs/PLAN.md's
// "Month Lifecycle" section) — blocked while any category_month row
// references it, for any month past or future.
model Category {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  name       String
  icon       String
  color      String
  budgetType BudgetType? @map("budget_type")
  direction  Direction

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // See BudgetMonth.user above for why Restrict, not Cascade.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  categoryMonths    CategoryMonth[]
  recurringExpenses RecurringExpense[]

  @@index([userId])
  @@map("categories")
}

// The real join: a category is "active" in a month iff a row exists here
// for it. Hard-deleted, not soft-deleted (see docs/PLAN.md's "Month Lifecycle"
// section) — deletion is only allowed once no Transaction references it.
model CategoryMonth {
  id                 String @id @default(uuid()) @db.Uuid
  userId             String @map("user_id") @db.Uuid
  categoryId         String @map("category_id") @db.Uuid
  monthId            String @map("month_id") @db.Uuid
  monthlyBudgetCents Int    @map("monthly_budget_cents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // See BudgetMonth.user above for why Restrict, not Cascade.
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  budgetMonth  BudgetMonth   @relation(fields: [monthId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([categoryId, monthId])
  @@index([userId, monthId]) // serves listByMonth/transactions' where: { userId, monthId } filter directly; userId is a leading prefix so this also covers plain userId lookups
  @@map("category_month")
}

// Hard-deleted, not soft-deleted (see docs/PLAN.md's "Month Lifecycle" section)
// — no undo, no batching, single or bulk delete is immediate and permanent.
model Transaction {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  categoryMonthId    String    @map("category_month_id") @db.Uuid
  recurringExpenseId String?   @map("recurring_expense_id") @db.Uuid
  amountCents        Int       @map("amount_cents")
  date               DateTime  @db.Date
  merchant           String?
  note               String?
  direction          Direction

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // See BudgetMonth.user above for why Restrict, not Cascade.
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  categoryMonth    CategoryMonth     @relation(fields: [categoryMonthId], references: [id], onDelete: Restrict)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: Restrict)

  // Forward-provisioned, not currently served by any query — flagged during
  // a whole-codebase audit (see docs/PROGRESS.md). transactionService.list
  // filters by a categoryMonthId set (via @@index([categoryMonthId]) below)
  // and sorts by date in application code, not a DB-level date-range WHERE.
  // Kept per PLAN.md's original "you'll filter by user + month constantly"
  // reasoning for a future cross-month history/search query; revisit if
  // that never materializes.
  @@index([userId, date])
  @@index([userId, createdAt]) // serves bankBalanceService's "every transaction created after the checkpoint" query — a different axis than date, since a backfilled transaction's date and its real insertion time can diverge
  @@index([categoryMonthId])
  @@index([recurringExpenseId])
  @@map("transactions")
}

// One flat row per recurring expense per month it exists in — replaces the
// old RecurringExpenseTemplate/RecurringExpenseInstance split (see
// docs/PLAN.md's Data Model section for why: recurring expenses have no
// dormant, month-independent existence the way Category does, so a
// transversal catalog table wasn't earning its complexity). No cross-month
// identity — each month's row is fully independent. Hard-deleted, matching
// CategoryMonth, for the identical reason — blocked while any Transaction
// references it. Points at an existing Category (never creates one).
// @@unique([monthId, name]): scoped per month, not global — "Rent" can
// exist once in October and once in November, just never twice in the
// same month.
model RecurringExpense {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  monthId     String     @map("month_id") @db.Uuid
  categoryId  String     @map("category_id") @db.Uuid
  name        String
  amountCents Int        @map("amount_cents")
  budgetType  BudgetType @map("budget_type")
  dueDay      Int        @map("due_day")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // See BudgetMonth.user above for why Restrict, not Cascade.
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  budgetMonth  BudgetMonth   @relation(fields: [monthId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([monthId, name])
  @@index([userId, monthId])
  @@map("recurring_expenses")
}

// A long-running savings goal, unrelated to any single month (see
// docs/GLOSSARY.md's "Category vs. Savings Fund"). Hard-deleted, not
// soft-deleted (see docs/PLAN.md's step 6 note — every entity built so
// far ended up hard-deleted with no undo, so this follows the same rule
// rather than keeping the original soft-delete sketch) — blocked while
// any movement references it. currentAmountCents and achieved are
// deliberately NOT columns here — both are computed at read time by
// savingsFundService (initialBalanceCents + SUM(movements), and
// currentAmountCents >= targetAmountCents respectively), matching
// recurringCommittedCents/paidThisMonth's same "never let a derived value
// drift out of sync with reality" reasoning.
model SavingsFund {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  name                String
  targetAmountCents   Int?      @map("target_amount_cents")
  initialBalanceCents Int       @map("initial_balance_cents")
  startDate           DateTime? @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  monthlyTargetCents  Int?      @map("monthly_target_cents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // See BudgetMonth.user above for why Restrict, not Cascade.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  movements SavingsMovement[]

  @@index([userId])
  @@map("savings_funds")
}

// One deposit/withdrawal event against a fund — same relationship to
// SavingsFund as Transaction has to CategoryMonth (docs/GLOSSARY.md).
// Hard-deleted, no soft-delete, no undo. amountCents is always positive —
// sign/meaning comes from `type`, same pattern as Transaction.direction.
// Editable/deletable after creation (unlike a real accounting ledger) —
// every write path (create/update/delete) re-validates that the fund's
// resulting balance can never go negative, computed fresh inside the same
// transaction as the write.
model SavingsMovement {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  fundId      String       @map("fund_id") @db.Uuid
  amountCents Int          @map("amount_cents")
  type        MovementType
  date        DateTime     @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // See BudgetMonth.user above for why Restrict, not Cascade.
  user User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  fund SavingsFund @relation(fields: [fundId], references: [id], onDelete: Restrict)

  // (fundId, userId), not (userId, date) as docs/PLAN.md's general indexing
  // note originally suggested — deliberate deviation, not an oversight: the
  // real query patterns (computeNetMovementCents/listByFundIds in
  // savingsMovementService) filter by fundId alone, not userId and not by a
  // date range — fundId leads so those queries actually range-scan the
  // index instead of a full index scan. userId trails, still available for
  // any future userId-scoped lookup. See docs/PLAN.md's indexing bullet.
  @@index([fundId, userId])
  @@map("savings_movements")
}
