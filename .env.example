# Copy this file to .env and fill in real values. .env itself is gitignored.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml's postgres service by default.
DATABASE_URL=postgresql://budget_app:budget_app@localhost:5432/budget_app?schema=public

# Comma-separated list of allowed browser origins for the (future) website client.
CORS_ORIGIN=http://localhost:19006

# Auth env vars (JWT_SECRET, email provider API key) are added in the auth (OTP) build step.
